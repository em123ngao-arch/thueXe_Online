# ============================================================
# DriveShare — Template biến môi trường
# ============================================================
# Sao chép file này thành .env và điền giá trị thật:
#   cp .env.example .env
# File .env đã được .gitignore — KHÔNG commit key thật lên Git!
# ============================================================

# --- Cloudinary Image CDN (Upload ảnh bên thứ ba) ---
# Đăng ký miễn phí tại: https://cloudinary.com/users/register_free
# Lấy 3 giá trị từ Dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# --- PostgreSQL Database ---
# DB_USERNAME=postgres
# DB_PASSWORD=postgrespassword

# --- Google OAuth2 (nếu bật) ---
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
