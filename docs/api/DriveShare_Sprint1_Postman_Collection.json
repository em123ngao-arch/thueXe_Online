		{
			"name": "3. Admin User Management",
			"item": [
				{
					"name": "GET Admin List Users (Filter, Search, Sort, Paging)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/users?page=1&limit=10&search=nam&role=owner&status=all&sortBy=created_at&sortDir=desc",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"admin",
								"users"
							],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Số trang (1-based)"
								},
								{
									"key": "limit",
									"value": "10",
									"description": "Số lượng user mỗi trang"
								},
								{
									"key": "search",
									"value": "nam",
									"description": "Tìm kiếm theo tên, email, sđt"
								},
								{
									"key": "role",
									"value": "owner",
									"description": "Lọc role: all, renter, owner, admin, staff"
								},
								{
									"key": "status",
									"value": "all",
									"description": "Lọc trạng thái: all, pending, active, locked"
								},
								{
									"key": "sortBy",
									"value": "created_at",
									"description": "Trường sắp xếp: created_at, full_name, email"
								},
								{
									"key": "sortDir",
									"value": "desc",
									"description": "Hướng sắp xếp: asc hoặc desc"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "GET Admin User Detail (/admin/users/:userId)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/users/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"admin",
								"users",
								"1"
							]
						}
					},
					"response": []
				},
