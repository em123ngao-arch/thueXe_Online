								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"verification_status\": \"verified\",\n  \"rejection_reason\": \"\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/users/1/approve-owner",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"admin",
								"users",
								"1",
								"approve-owner"
							]
						}
					},
					"response": []
