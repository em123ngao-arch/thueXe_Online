						"url": {
							"raw": "{{baseUrl}}/admin/users/1/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"admin",
								"users",
								"1",
								"status"
							]
						}
					},
					"response": []
				}
			]
		},
